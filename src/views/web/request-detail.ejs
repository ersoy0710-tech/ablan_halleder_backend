<% const statusLabelMap = {
    draft: 'Taslak',
    published: 'Yayınlandı',
    assigned: 'Atandı',
    in_progress: 'Devam Ediyor',
    awaiting_approval: 'Onay Bekliyor',
    completed: 'Tamamlandı',
    canceled: 'İptal Edildi',
    approved: 'Onaylandı',
    disputed: 'İtiraz Edildi'
};
const statusClassMap = {
    draft: 'badge-secondary',
    published: 'badge-primary',
    assigned: 'badge-info',
    in_progress: 'badge-warning',
    awaiting_approval: 'badge-dark',
    completed: 'badge-success',
    canceled: 'badge-danger',
    approved: 'badge-success',
    disputed: 'badge-danger'
}; %>

<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">Talep Detayı</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <% if (!request) { %>
                <div class="alert alert-warning"><%= message || 'Talep bulunamadı.' %></div>
            <% } else { %>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">ID</dt>
                            <dd class="col-sm-8" id="requestId"><%- request.id %></dd>
                            <span id="jobId" class="d-none"><%- request.job_id %></span>

                            <dt class="col-sm-4">Müşteri</dt>
                            <dd class="col-sm-8"><%- request.customer %> (<%- request.customer_phone %>)</dd>

                            <dt class="col-sm-4">Adres</dt>
                            <dd class="col-sm-8"><%- request.address_summary %><br><small><%- request.full_address %></small></dd>

                            <dt class="col-sm-4">Temizlikçi</dt>
                            <dd class="col-sm-8"><%- request.cleaner_name || 'Henüz atanmadı' %> <% if(request.cleaner_phone) { %>(<%- request.cleaner_phone %>)<% } %></dd>

                            <dt class="col-sm-4">Durum</dt>
                            <dd class="col-sm-8">
                                <% const statusKey = request.status;
                                   const statusLabel = statusLabelMap[statusKey] || statusKey;
                                   const statusClass = statusClassMap[statusKey] || 'badge-secondary'; %>
                                <span class="badge badge-pill <%= statusClass %>"><%= statusLabel %></span>
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Başlık</dt>
                            <dd class="col-sm-8"><%- request.title %></dd>

                            <dt class="col-sm-4">Alan (m²)</dt>
                            <dd class="col-sm-8"><%- request.area_sqm %></dd>

                            <dt class="col-sm-4">Evcil Hayvan</dt>
                            <dd class="col-sm-8"><%- request.has_pets ? 'Evet' : 'Hayır' %></dd>

                            <dt class="col-sm-4">Fiyat</dt>
                            <dd class="col-sm-8"><%- request.price ? request.price + ' TL' : '-' %></dd>

                            <dt class="col-sm-4">Planlanan</dt>
                            <dd class="col-sm-8"><%- request.scheduled_start %></dd>
                        </dl>
                    </div>
                </div>

                <% if (request.rating || request.dispute_reason) { %>
                    <div class="card mb-4">
                        <div class="card-body border-left-<%= request.rating ? 'success' : 'danger' %>">
                            
                            <% if (request.rating) { %>
                                <div class="mb-3">
                                    <h6 class="font-weight-bold text-success">Müşteri Değerlendirmesi (<%- request.rating %>/5)</h6>
                                    <p class="mb-0 text-gray-800"><%- request.comment || 'Yorum yapılmadı.' %></p>
                                </div>
                            <% } %>

                            <% if (request.dispute_reason) { %>
                                <div>
                                    <h6 class="font-weight-bold text-danger">
                                        <i class="fas fa-exclamation-circle"></i> İtiraz Sebebi
                                    </h6>
                                    <p class="mb-0 text-gray-800"><%- request.dispute_reason %></p>
                                </div>
                            <% } %>
                            
                        </div>
                    </div>
                <% } %>

                <div class="card mt-4">
                    <div class="card-header">Açıklama</div>
                    <div class="card-body">
                        <p><%- request.description %></p>
                    </div>
                </div>

                <% if ((beforePhotos && beforePhotos.length > 0) || (afterPhotos && afterPhotos.length > 0)) { %>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-warning text-dark font-weight-bold">
                                    <i class="fas fa-camera mr-1"></i> Temizlik Öncesi
                                </div>
                                <div class="card-body">
                                    <% if (beforePhotos && beforePhotos.length > 0) { %>
                                        <div class="row">
                                            <% beforePhotos.forEach(url => { %>
                                                <div class="col-4 mb-3">
                                                    <a href="<%- url %>" target="_blank">
                                                        <img src="<%- url %>" class="img-fluid rounded border" style="object-fit: cover; height: 100px; width: 100%;" alt="Öncesi">
                                                    </a>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <p class="text-muted">Fotoğraf yüklenmemiş.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-success text-white font-weight-bold">
                                    <i class="fas fa-check-circle mr-1"></i> Temizlik Sonrası
                                </div>
                                <div class="card-body">
                                    <% if (afterPhotos && afterPhotos.length > 0) { %>
                                        <div class="row">
                                            <% afterPhotos.forEach(url => { %>
                                                <div class="col-4 mb-3">
                                                    <a href="<%- url %>" target="_blank">
                                                        <img src="<%- url %>" class="img-fluid rounded border" style="object-fit: cover; height: 100px; width: 100%;" alt="Sonrası">
                                                    </a>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <p class="text-muted">Fotoğraf yüklenmemiş.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
                
                <div class="mt-4">
                    <% if (request.status === 'draft') { %>
                        <button type="button" id="approve-btn" class="btn btn-success mr-2">Talebi Onayla</button>
                        <button type="button" id="reject-btn" class="btn btn-danger">Talebi Reddet</button>
                    <% } else if (request.status === 'disputed') { %>
                        <h6 class="font-weight-bold text-danger mb-3">Admin İtiraz Kararı</h6>
                        <button type="button" id="resolve-reject-dispute" class="btn btn-success mr-2">
                            <i class="fas fa-check"></i> İtirazı Reddet (İşi Onayla)
                        </button>
                        <button type="button" id="resolve-cancel-job" class="btn btn-danger">
                            <i class="fas fa-ban"></i> Haklı İtiraz (İşi İptal Et)
                        </button>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const approveBtn = document.getElementById('approve-btn');
    const rejectBtn = document.getElementById('reject-btn');
    
    const rejectDisputeBtn = document.getElementById('resolve-reject-dispute');
    const cancelJobBtn = document.getElementById('resolve-cancel-job');
    
    const requestId = document.getElementById('requestId') ? document.getElementById('requestId').innerText.trim() : '';
    const jobId = document.getElementById('jobId') ? document.getElementById('jobId').innerText.trim() : '';

    function func(url, method, bodyData, button, otherBtn, opName) {
        if(button) button.disabled = true;
        if(otherBtn) otherBtn.disabled = true;
        const oldText = button ? button.innerHTML : '';
        if(button) button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> İşleniyor...';

        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(bodyData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message || `İşlem başarıyla ${opName}.`);
                window.location.reload();
            } else {
                alert(data.message || 'Bir hata oluştu.');
                if(button) button.disabled = false;
                if(otherBtn) otherBtn.disabled = false;
                if(button) button.innerHTML = oldText;
            }
        })
        .catch(error => {
            console.error('Hata:', error);
            alert('Sistemsel bir hata oluştu.');
            if(button) button.disabled = false;
            if(otherBtn) otherBtn.disabled = false;
            if(button) button.innerHTML = oldText;
        });
    }

    if (approveBtn) {
        approveBtn.addEventListener('click', function() {
            func(`/request/${requestId}/approve`, 'POST', { requestId: requestId }, approveBtn, rejectBtn, 'onaylandı');
        });
    }

    if (rejectBtn) {
        rejectBtn.addEventListener('click', function() {
            if (confirm('Bu talebi reddetmek istediğinize emin misiniz?')) {
                func(`/request/${requestId}/reject`, 'POST', { requestId: requestId }, rejectBtn, approveBtn, 'reddedildi');
            }
        });
    }

    if (rejectDisputeBtn) {
        rejectDisputeBtn.addEventListener('click', function() {
            if (confirm('İtirazı yersiz bulup, işlemi TAMAMLANMIŞ (Onaylandı) olarak kapatmak istiyor musunuz?')) {
                func(`/resolve-dispute`, 'POST', { jobId: jobId, requestId: requestId, decision: 'approve' }, rejectDisputeBtn, cancelJobBtn, 'tamamlandı');
            }
        });
    }

    if (cancelJobBtn) {
        cancelJobBtn.addEventListener('click', function() {
            if (confirm('Müşteriyi haklı bulup işlemi İPTAL etmek istiyor musunuz?')) {
                func(`/resolve-dispute`, 'POST', { jobId: jobId, requestId: requestId, decision: 'cancel' }, cancelJobBtn, rejectDisputeBtn, 'iptal edildi');
            }
        });
    }
});
</script>